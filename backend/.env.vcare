# ═══════════════════════════════════════════════════
# V-CARE HOSPITAL — Backend Environment Variables
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in the actual values
# DO NOT commit .env — it contains secrets

# Supabase (New V-Care project — REPLACE THESE)
SUPABASE_URL=https://YOUR_VCARE_PROJECT.supabase.co
SUPABASE_KEY=YOUR_VCARE_SERVICE_ROLE_KEY

# Timezone
BUSINESS_TIMEZONE=Asia/Kolkata

# Auto checkout — buffer before closing sessions
AUTO_CHECKOUT_BUFFER_MINUTES=15

# Device polling interval (seconds)
DEVICE_POLL_INTERVAL_SECONDS=60

# Duplicate punch threshold (seconds)
DUPLICATE_THRESHOLD_SECONDS=120

# JWT Auth — GENERATE A NEW SECRET for V-Care
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_NEW_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
